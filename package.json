{
  "name": "pegasi-classroom-install",
  "displayName": "Pegasi 課堂安裝",
  "description": "課堂側邊欄：兌換邀請碼與 BYOK、檢查／安裝環境工具，並一鍵執行本課安裝動作。",
  "version": "0.2.0",
  "publisher": "vans-coding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mz038197/pegasi-one-click-install.git"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:pegasiClassroomInstall.sidebar",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Pegasi 課堂安裝",
      "properties": {
        "pegasiClassroomInstall.routerBaseUrl": {
          "type": "string",
          "default": "http://203-71-78-31.nip.io:8000",
          "description": "Pegasi Router 公開網址（進階；一般課堂不必改）"
        }
      }
    },
    "commands": [
      {
        "command": "pegasiClassroomInstall.runInstallAction",
        "title": "執行本課安裝動作"
      },
      {
        "command": "pegasiClassroomInstall.recheckEnvironment",
        "title": "重新檢查環境工具"
      },
      {
        "command": "pegasiClassroomInstall.installEnvironmentTool",
        "title": "安裝／修復環境工具"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pegasiClassroomInstall",
          "title": "Pegasi 課堂安裝",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pegasiClassroomInstall": [
        {
          "type": "webview",
          "id": "pegasiClassroomInstall.sidebar",
          "name": "Pegasi 課堂安裝"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/**/*.test.js",
    "typecheck": "tsc -p ./ --noEmit",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --readme-path EXTENSION_README.md"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
